// https://www.typescriptlang.org/tsconfig/
{
  "compilerOptions": {
    // Language and Environment
    "target": "ES2020",
    // Modules
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "resources/*": ["./resources/*"],
      "src/*": ["./src/*"]
    },
    // Emit
    //
    // Nothing in this repository is emitted by tsc: vite builds the client and
    // tsx runs the server. Saying so explicitly is not tidiness — with
    // `allowJs` on and the gate scripts in the program, a config that *could*
    // emit makes the linters refuse the whole project with "cannot write file
    // ... because it would overwrite input file".
    "noEmit": true,
    "sourceMap": true,
    // Type Checking
    "allowUnusedLabels": false,
    "experimentalDecorators": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "useDefineForClassFields": false,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"]
  },
  "include": [
    "src/**/*",
    "zbin/**/*",
    "resources/**/*",
    "generated/**/*",
    "tests/**/*",
    "src/scripts",
    // Build-time scripts, top level only. Without this, eslint's project
    // service refuses any script that no test happens to import and aborts on
    // the file instead of reporting anything -- the same shape as the
    // four-exclusion-list trap, from the other direction.
    //
    // Not "scripts/**/*.ts": that pulls in upstream's GitHub automation under
    // issue-lifecycle/ and pr-gate/, which needs @octokit/rest and is not a
    // dependency of this fork. The parts of it a test actually imports are
    // already in the program through tests/.
    "scripts/*.ts",
    // And the gate scripts, which are .mjs. They are here rather than in
    // eslint's `allowDefaultProject` because that list is capped at eight
    // matched files, and phase 6 was the ninth: the linter then aborts with
    // "Too many files have matched the default project" and reports nothing
    // at all. A real tsconfig project has no such cap. `checkJs` stays off,
    // so this puts them in the program without typechecking their contents.
    "scripts/*.mjs",
    "vite.config.ts",
    "drizzle.config.ts"
  ],
  // _legacy/ holds the inherited client and its tests, kept as reference
  // until their replacements exist (see src/client/_legacy/README.md).
  // Note this does not by itself cut them out: exclude only filters the root
  // set, so an excluded file still enters the program if something included
  // imports it. Nothing does — tests/architecture/QuarantineBoundary.test.ts
  // is what actually holds that.
  "exclude": ["node_modules", "src/client/_legacy", "tests/_legacy"]
}
