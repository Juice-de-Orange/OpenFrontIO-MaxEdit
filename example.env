# The world server reads these. Copy to .env and adjust, or set them in the
# environment; docker-compose.yml already passes the ones it needs.

# Postgres. Unset means the world keeps its history in memory and loses it when
# the process ends -- fine for the client development loop, and it says so at
# startup. Anything else needs this.
DATABASE_URL=postgres://openfront:openfront@localhost:5432/openfront

# Which world this process ticks. Also the key of the advisory lock that keeps
# a second process off it, so two worlds on one database need two ids.
WORLD_ID=world-0

# Which map. Must be one of the maps built into the image -- see WORLD_MAPS in
# docker-compose.yml. The server lists what it has if this names another.
MAP_ID=europe

# /ws and /health share this port.
PORT=3000

# Compose only. Change it for anything reachable from outside the host.
POSTGRES_PASSWORD=openfront

# Compose only: where Postgres is published on the host. Move it if 5432 is
# taken.
POSTGRES_PORT=5432

# The integration tests in tests/server/PgStore.test.ts are skipped unless this
# is set. `npm run test:db` sets it to the compose database.
TEST_DATABASE_URL=

# Optional CDN origin (e.g. https://cdn.example.com) prepended to hashed asset
# URLs from asset-manifest.json. Leave empty to serve assets from the same
# origin as the app. No trailing slash.
CDN_BASE=
